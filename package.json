{
  "name": "open-quran-view",
  "version": "0.1.0",
  "description": "Universal, cross-platform Quran component library for high-fidelity Mushaf rendering.",
  "type": "module",
  "main": "./dist/core/index.js",
  "exports": {
    "./core": "./dist/core/index.js",
    "./react": "./dist/view/react/index.js",
    "./native": "./dist/view/native/index.js",
    "./web": "./dist/view/web/index.js"
  },
  "files": [
    "dist",
    "assets",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/**",
    "test": "vitest",
    "generate:pages": "node scripts/generate-pages.cjs"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=0.1",
    "canvaskit-wasm": ">=0.3",
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "better-sqlite3": "^12.6.2",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.4.0",
    "react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTarek/Java-Quran-Web.git"
  },
